# Your study progress is personal state, not program content. It changes
# every time you tick a module off; keeping it out of history means your
# reading position never shows up as a diff, and a restore never rewinds it.
_app/data/progress.json

# Python bytecode.
__pycache__/
*.pyc

# Editor and OS noise.
*~
*.bak
*.orig
Thumbs.db
desktop.ini

# Assembled by _app/build.mjs at deploy time.
public/

# Vercel CLI local state.
.vercel/

# Node.
node_modules/

# Office lock files, created while a deck or PDF is open. They are locked
# by Office itself, so git cannot even read them, and "git add" fails hard.
~$*
